# growlio와 공유하는 Supabase Postgres (Session Pooler, IPv4, port 5432)
# growlio/backend/.env의 DATABASE_URL과 같은 프로젝트를 가리키되, 드라이버만 sync(psycopg2)로 사용
DATABASE_URL=postgresql+psycopg2://postgres.xxxxx:your-db-password@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# growlio와 같은 Supabase 프로젝트 (Project Settings > API) — 로그인 검증(Auth)에만 사용
SUPABASE_PROJECT_URL=https://xyzabc.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# 부부 사진을 저장하는 Supabase Storage 버킷 (같은 프로젝트, Project Settings > API의 service_role 키 필요).
# 대시보드에서 SUPABASE_STORAGE_BUCKET 이름의 버킷을 미리 Private로 만들어둔다.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=nestlio-media

NOTIFY_EMAIL_TO=you@example.com

# React SPA(frontend/)가 API를 호출할 오리진 (dev: Vite, prod: 배포된 SPA 도메인) - JSON 배열
CORS_ORIGINS=["http://localhost:5273"]

# 프론트엔드 SPA의 오리진 (배우자 초대 이메일에 넣을 가입 링크 조립용, prod에서는 배포 도메인으로 변경)
APP_BASE_URL=http://localhost:5273

# growlio(자산관리, 별도 서비스) 백엔드 오리진 — 저축상품 ↔ growlio 계좌 자동 동기화용 읽기전용 API 호출.
# 비워두면 동기화 기능이 꺼진다(연동 UI에서 501로 안내).
GROWLIO_API_BASE_URL=http://localhost:8000

# Coaching engine default thresholds (percent, 0-100)
SAVINGS_RATE_WARN=20
SAVINGS_RATE_CRITICAL=10
FIXED_COST_RATIO_WARN=40
FIXED_COST_RATIO_CRITICAL=50
BUDGET_WARN_PCT=90
BUDGET_CRITICAL_PCT=100
DISCRETIONARY_RATIO_WARN=15
DEBT_RATIO_WARN=30

# 부부 사진 업로드 최대 크기(MB) — 저장소는 위 SUPABASE_STORAGE_BUCKET 참고
MAX_UPLOAD_SIZE_MB=5

# /internal/jobs/* 엔드포인트 인증용 공유 시크릿 (GitHub Actions 예약 워크플로가 이 값을
# X-Internal-Job-Secret 헤더로 보낸다. .github/workflows/scheduled-jobs.yml 참고)
INTERNAL_JOB_SECRET=change-me-to-a-random-secret

# Google OAuth 클라이언트 (Calendar/Gmail 연동, scripts/google_auth_setup.py 참고)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
