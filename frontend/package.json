{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --noEmit",
    "generate:api-types": "node scripts/generate-api-types.mjs",
    "generate:api-types:live": "openapi-typescript http://localhost:8899/openapi.json -o src/types/api.generated.ts",
    "generate:icons": "node scripts/generate-icons.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/query-sync-storage-persister": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "axios": "^1.21.1",
    "axios-retry": "^4.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.93.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "overridesComment": "js-yaml: openapi-typescript → @redocly/openapi-core 가 끌어오는 4.3.1 이 GHSA-2883-xcg3-v3hh(high). 빌드타임 전용이라 번들엔 안 들어가지만 npm audit 게이트를 통과시키려 패치본으로 고정. openapi-typescript 상위 릴리스가 해결하면 제거.",
  "overrides": {
    "js-yaml": "^4.3.2"
  }
}
