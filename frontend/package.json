{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate:api-types": "node scripts/generate-api-types.mjs",
    "generate:api-types:live": "openapi-typescript http://localhost:8899/openapi.json -o src/types/api.generated.ts",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/query-sync-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.82.0",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overridesComment": "js-yaml: openapi-typescript → @redocly/openapi-core 가 끌어오는 4.3.1 이 GHSA-2883-xcg3-v3hh(high). 빌드타임 전용이라 번들엔 안 들어가지만 npm audit 게이트를 통과시키려 패치본으로 고정. openapi-typescript 상위 릴리스가 해결하면 제거.",
  "overrides": {
    "js-yaml": "^4.3.2"
  }
}
