# frontend/.env — Vite가 빌드 시점에 번들에 그대로 굳혀 넣는다(src/lib/supabase.ts).
# 값이 없거나 오래된 채로 `npm run build`하면 런타임에 빈 화면만 남는다 — 수정 후 반드시 재빌드.

# growlio와 같은 Supabase 프로젝트 (Project Settings > API)
VITE_SUPABASE_URL=https://xyzabc.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# growlio(자산관리, 별도 서비스) 프론트엔드 오리진 — 자산 딥링크 CTA 조립용.
# 비워두면 growlio 딥링크 버튼이 숨겨진다(백엔드 GROWLIO_API_BASE_URL 미설정과 같은 폴백 철학).
VITE_GROWLIO_APP_URL=http://localhost:5273
